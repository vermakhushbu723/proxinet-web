# Copy to .env for local development. On Vercel add the same keys under Project → Settings → Environment Variables.

# MongoDB Atlas connection string (URL-encode special characters in the password, e.g. @ -> %40)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DB=proxinet

# Long random string used to sign admin login tokens
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# First admin account — created automatically on the first login attempt if no admin exists.
# Wrap values in double quotes if they contain # (otherwise everything after # is ignored).
ADMIN_EMAIL=admin@proxinet.in
ADMIN_PASSWORD="change-me"

PORT=5000
# Browser origins allowed to call the API: * = all, or a comma-separated list (same-origin calls are always allowed)
CORS_ORIGIN=*

# Only if Node cannot resolve mongodb+srv on your network (querySrv ECONNREFUSED)
# DNS_SERVERS=8.8.8.8,1.1.1.1

# ---- Renewal reminders (Admin → Renewals) ----
# The admin panel shows reminders from N days before a plan ends, every day, until it is marked Renewed / Not renewing.
RENEWAL_REMIND_DAYS=5
REMINDER_TZ=Asia/Kolkata
# Daily email digest is sent once a day after this hour (local server). On Vercel, vercel.json runs it at 09:00 IST.
REMINDER_HOUR=9
# Where the daily email goes (defaults to ADMIN_EMAIL). Leave SMTP_HOST empty to use only in-panel reminders.
REMINDER_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ProXinet Admin <no-reply@proxinet.in>"
# Link in the email, e.g. https://proxinet.in
SITE_URL=
# Vercel only: random string; Vercel Cron sends it as a Bearer token to /api/cron/renewal-reminders
CRON_SECRET=

# ---- SMS / WhatsApp reminders to team members (Admin → Reminder team) ----
# SMS_PROVIDER = fast2sms | twilio | webhook | log   (log = print to the server console, for testing)
SMS_PROVIDER=
# Fast2SMS (India): Dev API key from fast2sms.com → Dev API
FAST2SMS_API_KEY=
# Twilio: SMS, or WhatsApp with TWILIO_WHATSAPP=1 (TWILIO_FROM = your Twilio / WhatsApp sender number, e.g. +14155238886)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_WHATSAPP=0
# Any other gateway: we POST { to, mobile, message } as JSON (with optional Bearer token)
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
# MAIL_DRY_RUN=1 builds reminder emails without delivering them (testing)
MAIL_DRY_RUN=0
